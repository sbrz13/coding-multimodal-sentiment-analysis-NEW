{
    "data_config": {
        "batch_size": 4,
        "num_workers": 4,
        "use_merged_data": true,
        "augment": true
    },
    "train_config": {
        "learning_rate": 3e-6,
        "num_epochs": 50,
        "early_stop_patience": 12,
        "weight_decay": 1e-4,
        "warmup_ratio": 0.2,
        "device": "cuda",
        "seed": 42
    },
    "model_config": {
        "text_model": "roberta-large",
        "vision_model": "openai/clip-vit-large-patch14",
        "projection_dim": 768,
        "attention_dim": 768,
        "num_attention_heads": 12,
        "cross_attn_layers": 6,
        "dropout_rate": 0.3,
        "text_dropout_rate": 0.15,
        "image_dropout_rate": 0.4,
        "drop_path_rate": 0.2,
        "image_noise_scale": 0.1,
        "image_noise_prob": 0.4,
        "freeze_encoders": true,
        "contrastive_temperature": 0.07,
        "contrastive_weight": 0.05,
        "use_reliability_gate": true
    }
}
